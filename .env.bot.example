# Autonomous Bot Configuration

# Minimum profitability score (0-100) required to open a position
BOT_MIN_SCORE=70

# Maximum SOL to deploy per position
BOT_MAX_CAPITAL=1

# Maximum number of simultaneous open positions
BOT_MAX_POSITIONS=3

# How often to check for new pool opportunities (milliseconds)
BOT_UPDATE_INTERVAL=60000

# Path to bot's keypair JSON file (keep secret!)
# Generate with: npm run bot:gen-keypair > bot-keypair.json
BOT_KEYPAIR_PATH=./bot-keypair.json

# Optional: custom RPC URL (uses RPC_URL from main .env if not set)
# RPC_URL=https://api.mainnet-beta.solana.com
